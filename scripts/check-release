#!/usr/bin/env bash
# Slow clean-source lane. The default snapshots the selected working tree and
# serves it over Git locally; --public-ref repeats the same adopter flow against
# a published ref and proves that ref resolves to the intended immutable commit.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/pi-science-release.XXXXXX")
daemon_pid=
cleanup() {
  if [[ -n $daemon_pid ]]; then
    kill "$daemon_pid" 2>/dev/null || true
    wait "$daemon_pid" 2>/dev/null || true
  fi
  rm -rf "$tmp"
}
trap cleanup EXIT

mode=local
public_ref=
expected_sha=
while (($#)); do
  case "$1" in
    --public-ref)
      mode=public
      public_ref=${2:?--public-ref requires a value}
      shift 2
      ;;
    --expected-sha)
      expected_sha=${2:?--expected-sha requires a value}
      shift 2
      ;;
    *)
      printf 'unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

snapshot="$tmp/snapshot"
repo_url=
ref=
if [[ $mode == local ]]; then
  mkdir "$snapshot"
  # HEAD plus tracked edits and intended untracked files is the exact selected tree.
  git -C "$root" archive --format=tar HEAD | tar -xf - -C "$snapshot"
  git -C "$root" diff --binary HEAD | git -C "$snapshot" apply
  if [[ -n $(git -C "$root" ls-files --others --exclude-standard) ]]; then
    (cd "$root" && git ls-files --others --exclude-standard -z | tar --null -T - -cf -) | tar -xf - -C "$snapshot"
  fi
  git -C "$snapshot" init -q
  git -C "$snapshot" add -A
  git -C "$snapshot" -c user.name=release-check -c user.email=release-check@example.invalid commit -qm snapshot
  sha=$(git -C "$snapshot" rev-parse HEAD)

  mkdir -p "$tmp/git/local"
  git clone -q --bare "$snapshot" "$tmp/git/local/pi-science.git"
  git -C "$tmp/git/local/pi-science.git" update-server-info
  port=$(python - <<'PY'
import socket
with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)
  python -m http.server "$port" --bind 127.0.0.1 --directory "$tmp/git" \
    >"$tmp/git-server.log" 2>&1 &
  daemon_pid=$!
  repo_url="http://127.0.0.1:$port/local/pi-science.git"
  ref=$sha
  for _ in {1..100}; do
    if git ls-remote "$repo_url" "$sha" >/dev/null 2>&1; then break; fi
    sleep 0.05
  done
  git ls-remote "$repo_url" >/dev/null
else
  [[ $expected_sha =~ ^[0-9a-f]{40}$ ]] || {
    printf '%s\n' '--expected-sha must be a full lowercase 40-character commit SHA' >&2
    exit 2
  }
  repo_url="https://github.com/hypnotox/pi-science.git"
  ref=$public_ref
  resolved=$(git ls-remote "$repo_url" "$public_ref" "${public_ref}^{}" | tail -n 1 | awk '{print $1}')
  [[ $resolved == "$expected_sha" ]] || {
    printf 'public ref %s resolved to %s, expected %s\n' "$public_ref" "${resolved:-nothing}" "$expected_sha" >&2
    exit 1
  }
  sha=$expected_sha
fi

pi_source="${repo_url}@${ref}"
python_source="py-science-formula @ git+${repo_url}@${ref}#subdirectory=packages/py-science-formula"
printf '==> source pins resolve %s\n' "$sha"

# Exercise the persistent-project dependency form from an isolated environment.
persistent="$tmp/persistent-python"
mkdir "$persistent"
cat >"$persistent/pyproject.toml" <<EOF
[project]
name = "pi-science-release-check"
version = "0"
requires-python = ">=3.13,<3.14"
dependencies = ["$python_source"]
EOF
UV_CACHE_DIR="$tmp/uv-persistent" uv sync --project "$persistent" --python 3.13 >/dev/null
UV_CACHE_DIR="$tmp/uv-persistent" uv run --project "$persistent" python - <<'PY'
from py_science.formula import AnalysisRequest, FormulaSyntax, analyze
outcome = analyze(AnalysisRequest(syntax=FormulaSyntax.SYMPY, expression="n + 1"))
assert outcome.operation_counts.additions == 1
PY

# Exercise the independently pinned PEP 723 form.
probe="$tmp/probe.py"
cat >"$probe" <<EOF
# /// script
# requires-python = ">=3.13,<3.14"
# dependencies = ["$python_source"]
# ///
from py_science.formula import AnalysisRequest, FormulaSyntax, analyze
result = analyze(AnalysisRequest(syntax=FormulaSyntax.SYMPY, expression="x * (y + 1)"))
assert result.operation_counts.multiplications == 1
EOF
UV_CACHE_DIR="$tmp/uv-probe" uv run "$probe" >/dev/null

# Install through Pi's real project Git-package manager and interrogate the
# noninteractive RPC host without making an LLM request.
project="$tmp/pi-project"
agent="$tmp/pi-agent"
mkdir -p "$project/.pi" "$agent"
printf '{"defaultProjectTrust":"always","enableInstallTelemetry":false}\n' >"$agent/settings.json"
export PI_BIN
PI_BIN=$(command -v pi)
(
  cd "$project"
  PI_CODING_AGENT_DIR="$agent" PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0 \
    GIT_TERMINAL_PROMPT=0 npm_config_cache="$tmp/npm-cache" \
    "$PI_BIN" install "$pi_source" -l --approve >/dev/null
)
python - "$project/.pi/settings.json" "$pi_source" <<'PY'
import json
import sys
settings = json.load(open(sys.argv[1], encoding="utf-8"))
assert settings["packages"] == [sys.argv[2]], settings
PY
verifier="$tmp/release-verifier.ts"
cat >"$verifier" <<'TS'
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
export default function verifier(pi: ExtensionAPI): void {
  pi.registerCommand("pi-science-release-check", {
    description: "Report host-visible release-check tools",
    handler: async (_args, context) => {
      context.ui.notify(
        JSON.stringify({ releaseCheckTools: pi.getAllTools().map((tool) => tool.name).sort() }),
        "info",
      );
    },
  });
}
TS

rpc_probe="$tmp/rpc-probe.py"
cat >"$rpc_probe" <<'PY'
import json
import os
import select
import subprocess
import sys
import time

project, agent, verifier, expected = sys.argv[1:]
env = os.environ.copy()
env.update({
    "PI_CODING_AGENT_DIR": agent,
    "PI_SKIP_VERSION_CHECK": "1",
    "PI_TELEMETRY": "0",
    "GIT_TERMINAL_PROMPT": "0",
})
proc = subprocess.Popen(
    [os.environ["PI_BIN"], "--mode", "rpc", "--no-session", "--approve", "--no-context-files", "-e", verifier],
    cwd=project,
    env=env,
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True,
    bufsize=1,
)
assert proc.stdin and proc.stdout and proc.stderr
for command in (
    {"id": "commands", "type": "get_commands"},
    {"id": "tools", "type": "prompt", "message": "/pi-science-release-check"},
    {"id": "doctor", "type": "prompt", "message": "/pi-science-doctor"},
):
    proc.stdin.write(json.dumps(command) + "\n")
proc.stdin.flush()
commands = None
tools = None
doctor = None
deadline = time.monotonic() + 240
try:
    while time.monotonic() < deadline and (commands is None or tools is None or doctor is None):
        ready, _, _ = select.select([proc.stdout], [], [], 0.25)
        if not ready:
            if proc.poll() is not None:
                raise AssertionError(f"Pi exited {proc.returncode}: {proc.stderr.read()}")
            continue
        line = proc.stdout.readline()
        if not line:
            continue
        event = json.loads(line)
        if event.get("id") == "commands" and event.get("type") == "response":
            commands = {item["name"] for item in event["data"]["commands"]}
        if event.get("type") == "extension_ui_request" and event.get("method") == "notify":
            message = event.get("message", "")
            if message.startswith('{"releaseCheckTools"'):
                tools = set(json.loads(message)["releaseCheckTools"])
            elif "Formula analysis is ready" in message or "Reload or restart" in message:
                doctor = message
    assert commands is not None and "pi-science-doctor" in commands, (commands, proc.stderr.read() if proc.poll() is not None else "")
    assert tools is not None and doctor is not None, (tools, doctor, commands)
    if expected == "ready":
        assert "skill:pi-science-formula-analysis" in commands, commands
        assert "analyze_formula" in tools, tools
        assert "Formula analysis is ready" in doctor, doctor
    else:
        assert "skill:pi-science-formula-analysis" not in commands, commands
        assert "analyze_formula" not in tools, tools
        assert "Reload or restart" in doctor, doctor
finally:
    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
PY

printf '==> Pi Git-package startup resolves %s\n' "$sha"
export XDG_CACHE_HOME="$tmp/pi-healthy-cache"
export npm_config_cache="$tmp/npm-cache"
python "$rpc_probe" "$project" "$agent" "$verifier" ready
installed=$(git -C "$project/.pi/git" rev-parse --verify "HEAD^{commit}" 2>/dev/null || true)
if [[ -z $installed ]]; then
  installed=$(find "$project/.pi/git" -type d -name .git -print -quit | xargs -r dirname | xargs -r git -C 2>/dev/null rev-parse HEAD || true)
fi
# Pi's managed checkout itself is the authoritative package-manager evidence.
managed_checkout=$(find "$project/.pi/git" -type d -name .git -print -quit | xargs -r dirname)
[[ -n $managed_checkout ]]
[[ $(git -C "$managed_checkout" rev-parse HEAD) == "$sha" ]]

# Reuse the installed checkout but remove uv from PATH: startup must retain only
# diagnostics and the verifier, withholding the analysis tool and product skill.
no_uv="$tmp/no-uv-bin"
mkdir "$no_uv"
for command in node npm git pi; do
  target=$(command -v "$command")
  ln -s "$target" "$no_uv/$command"
done
PATH="$no_uv:/usr/bin:/bin" XDG_CACHE_HOME="$tmp/pi-disabled-cache" \
  python "$rpc_probe" "$project" "$agent" "$verifier" disabled

printf 'check-release: OK (Pi and Python pins resolve to %s)\n' "$sha"
