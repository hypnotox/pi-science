#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

temp_root=${XDG_CACHE_HOME:-$HOME/.cache}/pi-science
mkdir -p "$temp_root"
check_tmp=$(mktemp -d "$temp_root/check.XXXXXX")
cleanup() {
  rm -rf "$check_tmp"
}
trap cleanup EXIT
export TMPDIR="$check_tmp"

printf '==> pytest\n'
uv run --locked pytest
printf '==> generated Pi formula schema\n'
uv run --locked python scripts/generate-pi-formula-schema.py --check
printf '==> pyright\n'
uv run --locked pyright
printf '==> ruff\n'
uv run --locked ruff check packages/py-science-formula/src packages/pi-science/bridge scripts/generate-pi-formula-schema.py tests
printf '==> Pi TypeScript\n'
npm run check:pi
npm run format:pi
npm run test:pi
printf '==> awf\n'
./awf check
